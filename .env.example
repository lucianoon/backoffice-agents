# ---- LLM (gera texto e raciocina) ----
# Provedores: openai (inclui qualquer endpoint OpenAI-compatível: Ollama, Groq, vLLM, OpenRouter),
# anthropic, bedrock_converse, google_genai, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Só para endpoints OpenAI-compatíveis (ex.: http://localhost:11434/v1 para Ollama)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# ---- Jev (decide, roteia, verifica) ----
# real     -> POST https://api.typesafe.ai/v1/systemone (precisa de TYPESAFE_API_KEY)
# emulated -> o LLM acima imita o formato Noul/Choice/Score (NÃO calibrado; só para desenvolver)
JEV_MODE=emulated
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Pseudonimiza e-mails, CPF/CNPJ, cartões, telefones e nomes do cliente antes de enviar ao Jev
JEV_ANONYMIZE=true
# Com JEV_MODE=real: se a API falhar, usa o emulador (marcado como não calibrado no log)
JEV_FALLBACK_EMULATED=true
# Reprocessamentos de um item em 'error' antes de marcar 'failed'
MAX_ATTEMPTS=3

# ---- Política de confiança ----
CONFIDENCE_AUTO=0.85
CONFIDENCE_REVIEW=0.55
# Por categoria (JSON), vencem os globais. Gere com: backoffice eval-shadow --suggest-thresholds
CONFIDENCE_AUTO_BY_CATEGORY={}
CONFIDENCE_REVIEW_BY_CATEGORY={}
GATE_MIN_CONFIDENCE=0.70
VERIFY_MIN_QUALITY=3.5
VERIFY_MIN_RESOLVES=0.70

# ---- Adapters (mock | real) ----
EMAIL_ADAPTER=mock
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

CRM_ADAPTER=mock
ERP_ADAPTER=mock

TELEGRAM_ADAPTER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# No mock, aprova automaticamente os pedidos de aprovação (útil para demo)
TELEGRAM_MOCK_AUTO_APPROVE=true
# Ids de usuário do Telegram autorizados a aprovar/rotular (vazio = qualquer um no chat autorizado)
TELEGRAM_OPERATORS=

# ---- Prompt injection: acima desta probabilidade o e-mail escala sem passar pelo LLM ----
INJECTION_ESCALATE=0.70

# ---- Persistência e fila ----
# SQLite para desenvolver; Postgres para vários workers: postgresql+psycopg://backoffice:backoffice@localhost:5432/backoffice
DB_URL=sqlite:///data/backoffice.db

# ---- Custo (US$ por milhão de tokens) para `backoffice costs` ----
LLM_PRICE_INPUT_PER_M=0.40
LLM_PRICE_OUTPUT_PER_M=1.60
JEV_PRICE_INPUT_PER_M=0.042

# ---- Rastreamento: none | langsmith | langfuse ----
TRACING=none
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=backoffice-agents
# Langfuse (uv sync --extra langfuse): LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST
SAMPLES_PATH=data/samples/emails.json
